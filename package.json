{
  "name": "it-visual-kit",
  "version": "0.2.1",
  "private": true,
  "description": "Reusable graphics for IT videos, rendered with Remotion",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "npm run studio",
    "studio": "remotion studio src/index.ts --port=3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "render:mp4": "node scripts/render.mjs mp4",
    "render:png": "node scripts/render.mjs png"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@remotion/cli": "4.0.533",
    "@remotion/bundler": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
